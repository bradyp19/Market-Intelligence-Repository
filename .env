# Database Configuration
# For Docker development, set USE_SQLITE=false to use PostgreSQL
# For local development, set USE_SQLITE=true to use SQLite
USE_SQLITE=false

# PostgreSQL settings (used when USE_SQLITE=false)
DB_HOST=db
DB_PORT=5432
DB_NAME=competitive_intelligence
DB_USER=postgres
DB_PASSWORD=postgres
SECRET_KEY=dev-secret-key-change-in-production
